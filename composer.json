{
    "name": "rgilyov/laravel-csv-importer",
    "description": "Easy and reliable way to import, parse, validate and transform your csv files with laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "csv",
        "import",
        "laravel",
        "parse",
        "validate",
        "transform"
    ],
    "authors": [
        {
            "name": "Roman Gilyov",
            "email": "rgilyov@gmail.com"
        }
    ],
    "require-dev": {
        "mockery/mockery": "^1.6.15",
        "phpunit/phpunit": "^13.4.5",
        "predis/predis": "^3.7.0"
    },
    "require": {
        "arvenil/ninja-mutex": "^0.6",
        "illuminate/support": "^13.0",
        "league/csv": "^9.29.0",
        "nesbot/carbon": "^3.15.1",
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "RGilyov\\CsvImporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RGilyov\\CsvImporter\\Test\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/vendor",
            "/.history",
            "/.env",
            "/.env.*",
            "/composer.lock"
        ]
    }
}
